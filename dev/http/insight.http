GET {{base_url}}/v1/insights
Authorization: Bearer {{auth_token}}
Accept: application/json

###

GET {{base_url}}/v1/insights?tag=purpose-driven-work
Authorization: Bearer {{auth_token}}
Accept: application/json

###

POST {{base_url}}/v1/insights
Authorization: Bearer {{auth_token}}
Accept: application/json

{
    "text": "This is an insight text",
}

###

GET {{base_url}}/v1/tags
Authorization: Bearer {{auth_token}}
Accept: application/json

###

# Import all Readwise highlights, using the server-configured READWISE_API_TOKEN.
POST {{base_url}}/v1/readwise/import
Authorization: Bearer {{auth_token}}
Accept: application/json

###

# Import only the 20 most recently highlighted ones, with a one-off token.
POST {{base_url}}/v1/readwise/import
Authorization: Bearer {{auth_token}}
Accept: application/json

{
    "token": "your-readwise-token",
    "limit": 20
}

###

# Import only the 20 most recently highlighted favorites.
POST {{base_url}}/v1/readwise/import
Authorization: Bearer {{auth_token}}
Accept: application/json

{
    "limit": 20,
    "only_favorites": true
}

###
